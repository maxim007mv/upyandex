PROJECT_NAME=Notification & Mailing Management System
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=supersecretkeyformailingapplication1234567890abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database (PostgreSQL for production / Docker, or SQLite for zero-config local testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/mailing_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./mailing.db

# Redis & Celery
REDIS_URL=redis://localhost:6389/0
CELERY_BROKER_URL=redis://localhost:6389/0
CELERY_RESULT_BACKEND=redis://localhost:6389/0

# Email Gateway (Mailpit / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
EMAILS_FROM_EMAIL=noreply@notifications.local
EMAILS_FROM_NAME=Notification Service

# Settings
UNSUBSCRIBE_BASE_URL=http://localhost:5173/unsubscribe
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin123456
ENVIRONMENT=development
SEND_RATE_LIMIT_PER_SEC=20
